<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MathArt"
        x:Class="MathArt.MainWindow"
        Title="MathArt - Animasi Matematika"
        Width="1024" Height="768"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="250, *">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#252526" Padding="15">
            <StackPanel Spacing="15">
                <TextBlock Text="MathArt" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0, 0, 0, 10" />
                <TextBlock Text="Pilih Visualisasi:" Foreground="#CCCCCC" FontSize="14" />
                
                <ListBox x:Name="AnimationList" SelectedIndex="0" Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10" />
                            <Setter Property="Margin" Value="0, 2" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                    </ListBox.Styles>
                    <ListBoxItem Content="0. Lissajous Curve" />
                    <ListBoxItem Content="1. Generative Wave" />
                    <ListBoxItem Content="2. Polar Flower" />
                    <ListBoxItem Content="3. Algorithmic Spiral Grid" />
                    <ListBoxItem Content="4. Fibonacci Spiral" />
                    <ListBoxItem Content="5. Concentric Circles" />
                    <ListBoxItem Content="6. Random Walk" />
                </ListBox>

                <Separator Background="#444444" Margin="0, 10" />
                
                <Button x:Name="FullScreenToggle" Content="Toggle Fullscreen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#007ACC" Foreground="White" Padding="10" />
                <Button x:Name="ExitButton" Content="Exit" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#CC3333" Foreground="White" Padding="10" Margin="0, 5, 0, 0" />
            </StackPanel>
        </Border>

        <!-- Main View Area -->
        <Border Grid.Column="1" ClipToBounds="True">
            <local:MathCanvas x:Name="MathCanvasControl" />
        </Border>
    </Grid>
</Window>